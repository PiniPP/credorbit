# CredOrbit demo recording — reproduce with: vhs credorbit-demo.tape
# Uses `credorbit ui --demo`: synthetic acme-* accounts, no AWS calls, no file writes.
Output "credorbit-demo-raw.mp4"
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 16
Set Width 1280
Set Height 800
Set Padding 26
Set Margin 0
Set WindowBar Colorful
Set BorderRadius 12
Set Framerate 30
Set TypingSpeed 55ms
Set CursorBlink false
Set Theme {"name":"CredOrbit","black":"#111C31","red":"#F87171","green":"#34D399","yellow":"#FBBF24","blue":"#2563EB","magenta":"#818CF8","cyan":"#22D3EE","white":"#F8FAFC","brightBlack":"#94A3B8","brightRed":"#FCA5A5","brightGreen":"#6EE7B7","brightYellow":"#FDE68A","brightBlue":"#60A5FA","brightMagenta":"#A5B4FC","brightCyan":"#67E8F9","brightWhite":"#FFFFFF","background":"#0B1020","foreground":"#F8FAFC","selection":"#2563EB","cursor":"#22D3EE"}
Hide
Type `export PATH=$HOME/bin:$PATH COLORTERM=truecolor LANG=en_US.UTF-8 PS1=$'\[\e[38;2;34;211;238m\]❯\[\e[0m\] ' && clear`
Enter
Sleep 600ms
Show
Sleep 600ms
Type "credorbit version"
Sleep 300ms
Enter
Sleep 1500ms
Type "credorbit ui --demo"
Sleep 400ms
Enter
Sleep 2200ms
Sleep 1000ms
Down
Sleep 350ms
Down
Sleep 350ms
Down
Sleep 350ms
Up
Sleep 250ms
Up
Sleep 250ms
Up
Sleep 250ms
Sleep 600ms
Type "4"
Sleep 2600ms
Type "/"
Sleep 300ms
Type "payments"
Sleep 900ms
Enter
Sleep 1600ms
Type "c"
Sleep 600ms
Type "e"
Sleep 1000ms
Type "e"
Sleep 1400ms
Type "c"
Sleep 600ms
Down
Sleep 250ms
Space
Sleep 350ms
Down
Sleep 250ms
Space
Sleep 350ms
Down
Sleep 250ms
Space
Sleep 1300ms
Escape
Sleep 900ms
Type "5"
Sleep 2200ms
Down
Sleep 250ms
Space
Sleep 450ms
Down
Sleep 250ms
Space
Sleep 1200ms
Ctrl+S
Sleep 1800ms
Escape
Sleep 900ms
Type "1"
Sleep 1600ms
Enter
Sleep 1100ms
Enter
Sleep 1300ms
Enter
Sleep 1500ms
Type "s"
Sleep 2400ms
Sleep 1600ms
Type "a"
Sleep 400ms
Sleep 2400ms
Sleep 5400ms
Down
Sleep 250ms
Down
Sleep 250ms
Down
Sleep 250ms
Down
Sleep 250ms
Sleep 1200ms
Escape
Sleep 900ms
Type "/"
Sleep 300ms
Type "claude"
Sleep 600ms
Enter
Sleep 2200ms
Type "R"
Sleep 2800ms
Escape
Sleep 800ms
Type "/"
Sleep 300ms
Type "diag"
Sleep 600ms
Enter
Sleep 3600ms
Escape
Sleep 600ms
Type "q"
Sleep 1000ms
